  (text "POWER STAGE - SimpleFOC Mini (DRV8313)" (at 615 28 0) (effects (font (size 3 3) (thickness 0.6) bold) (justify left bottom)) (uuid "079ffd31-ccbb-5a42-9931-e7e46a9b0c41"))
  (text "INLINE CURRENT SENSE" (at 735 28 0) (effects (font (size 3 3) (thickness 0.6) bold) (justify left bottom)) (uuid "02b31288-6b2f-5048-87c4-24c6b2a9be8c"))
  (text "MOUNTING" (at 615 452 0) (effects (font (size 3 3) (thickness 0.6) bold) (justify left bottom)) (uuid "6b02751e-2594-51d3-8300-86af46f0f36f"))
  (text "U6 pin 2 is the DRV8313's 3.3 V LDO output (30 mA). It is deliberately" (at 615 268 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "b67c5f12-54d8-560d-b1ec-23de2ef2e975"))
  (text "left unconnected - it must never be paralleled with the carrier 3V3 rail." (at 615 274 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "813a777b-85a0-573d-83d7-474bf47401f3"))
  (text "RS1/RS2 are Kelvin-sensed: U3/U4 IN+/IN- leave from the inner edge of the" (at 735 445 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "4153fe7a-b3de-5e50-a5b5-afb7f039c3fe"))
  (text "shunt pads. IN+ is the Mini side, so positive current reads above 1.65 V." (at 735 451 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "e616b0c3-8e49-56bc-880f-c8451be497b5"))
  (text "Spare MCU pins PB0 PB1 PB5 PB10 PB11 PB13 are flagged no-connect;" (at 425 452 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "c7859681-52a4-50c2-ad0a-deb17f6f9370"))
  (text "they are the expansion for a spin-2 discrete bridge (see docs/06)." (at 425 458 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "44db2cb3-2e50-5e14-bf42-1ab72a105709"))
